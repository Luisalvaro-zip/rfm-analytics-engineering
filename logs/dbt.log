02:37:46.380880 [debug]: Query executed on node model.retail_ecommerce_dbt.int_customer_metrics:
/* {"app": "dbt", "dbt_version": "2.0.0", "invocation_id": "019e433e-b3b7-7ab2-853d-28d24b5e66cc", "node_id": "model.retail_ecommerce_dbt.int_customer_metrics", "profile_name": "retail_ecommerce_dbt", "target_name": "dev"} */

  
    

    create or replace table `ga4-project-496021`.`ga4_data_intermediate`.`int_customer_metrics`
      
    
    

    
    OPTIONS()
    as (
      -- Forzamos a que dbt cree una tabla real en BigQuery (soluciona el no-op)


with staging_transactions as (
    select * from `ga4-project-496021`.`ga4_data_staging`.`stg_retail_transaction`
),

-- 1. Calculamos la fecha máxima (el "hoy" del dataset) una sola vez
global_metrics as (
    select max(transaction_date) as max_date 
    from staging_transactions
),

-- 2. Armamos la base del RFM cruzando los datos
rfm_base as (
    select 
        t.customer_id,
        
        -- RECENCY: Restamos la última compra del cliente contra la fecha global
        date_diff(cast(max(g.max_date) as date), cast(max(t.transaction_date) as date), DAY) as recency_days,
        
        -- FREQUENCY: Cantidad de tickets (facturas) distintos
        count(distinct t.transaction_id) as frequency_count,
        
        -- MONETARY: Suma de la venta total
        sum(t.quantity * t.unit_price) as monetary_value

    from staging_transactions t
    cross join global_metrics g
    where t.customer_id is not null
    group by t.customer_id
)

select * from rfm_base
    );
  
